{
  "name": "client-generator",
  "version": "1.0.0",
  "main": "main.js",
  "author": "Generated by YJK Technologies",
  "license": "MIT",
  "devDependencies": {
    "electron": "^25.0.0",
    "electron-builder": "^24.6.0"
  },
  "build": {
    "appId": "com.yjktechnologies.clientgenerator",
    "productName": "Client Info Generator - YJK Technologies",
    "copyright": "Copyright © 2025 YJK Technologies",
    "extraResources": [
      {
        "from": "renderer/logo.png",
        "to": "assets/logo.png"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico" 
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "icon.ico",    
      "uninstallerIcon": "icon.ico",
      "uninstallDisplayName": "YJK Technologies Client Info Generator",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "YJK Technologies Client Generator"
    }
  },
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  }
}
